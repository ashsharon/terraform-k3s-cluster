# Copy to terraform.tfvars and fill in — terraform.tfvars is gitignored.
# hcloud_token is deliberately NOT set here: export it instead so it never
# touches disk in plaintext:
#   export TF_VAR_hcloud_token="your-hetzner-api-token"

cluster_name           = "icp-k3s"
location               = "nbg1"
ssh_public_key_path    = "~/.ssh/id_ed25519.pub"
admin_cidr             = "203.0.113.4/32" # your public IP — `curl ifconfig.me`
server_type            = "cx22"
agent_server_type      = "cx22"
agent_count            = 2
private_network_iface  = "enp7s0" # verify after first boot; see README
